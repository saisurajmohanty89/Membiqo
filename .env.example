# Membiqo — example only. Copy to .env.local and fill in your own values.
# Never commit .env.local or real secret values.

# Public web app origin (adjust per environment)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings; public key is safe in browser only when RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only. Use narrowly for privileged server setup/admin functions.
# Never expose via NEXT_PUBLIC_ or include it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY

# Do not configure platform payment provider keys in v1.
# Membiqo beta: business subscriptions are ₹0, with no checkout.
